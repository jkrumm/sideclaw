<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- `-server`, not the historical `com.jkrumm.sideclaw`, and the suffix is
       load-bearing rather than cosmetic. Background Task Management stores a
       disposition per IDENTIFIER, and this machine's entry for
       `8.com.jkrumm.sideclaw` is denied. Measured 2026-08-06: removing the
       plist entirely, re-adding it, and re-adding it under a different filename
       all re-registered as [enabled, disallowed] — the denial outlives the
       file. A label BTM has never seen registers allowed. Renaming back
       resurrects the boot failure. -->
  <key>Label</key>
  <string>com.jkrumm.sideclaw-server</string>

  <!-- A wrapper script, NOT /opt/homebrew/bin/bun directly. macOS Background
       Task Management resolves a launch item's effective disposition from its
       executable, and bun is denied on this host: a direct-bun agent registers
       [enabled, allowed] and BTM immediately downgrades it to
       [enabled, disallowed], which makes launchd skip RunAtLoad and leave the
       job to a late (or absent) KeepAlive spawn. Measured 2026-08-06 — three
       reboots produced one no-start and two ~3-minute-late starts, against ~18s
       for every allowed agent. The same probe via a shell script resolved to
       [enabled, allowed]. Full argument in scripts/sideclaw-start.sh. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jkrumm/SourceRoot/sideclaw/scripts/sideclaw-start.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jkrumm/SourceRoot/sideclaw</string>

  <!-- Bun auto-loads .env from WorkingDirectory — no need to repeat vars here -->

  <!-- launchd's default PATH (/usr/bin:/bin:/usr/sbin:/sbin) lacks Homebrew and
       user-local bins. Worker `claude -p` subprocesses inherit this process's env,
       so a missing PATH here breaks global hooks (e.g. the SessionEnd bun shebang
       in ~/.claude/hooks/notify.ts) with "bun: No such file or directory". -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/Users/jkrumm/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <!-- Above SHUTDOWN_GRACE_MS + SHUTDOWN_FLUSH_MS (server/lib/shutdown.ts: 40 min drain + 3 s
       flush = 2403 s), with real margin — ~5 min, not a hairline one. launchd's default
       ExitTimeOut is 20 s: with a 40-min drain and no override, launchd SIGKILLs the process
       mid-drain, which looks exactly like the silent-exit failure this file's forensic
       comments already describe for other causes (see docs/deployment.md § Drain window
       sizing, 2026-09-08 — SHUTDOWN_GRACE_MS covers the dominant single-attempt worst case
       deliberately, not the full double-timeout-fallback chain; that section has the math).
       ORDER MATTERS: this key must exist and exceed the drain window, or the drain change is
       inert.

       EDITING THIS FILE IS NOT ENOUGH: `make reload` only signals the already-loaded job
       definition (`launchctl kill`) — it never re-reads the plist. `launchctl print
       gui/<uid>/com.jkrumm.sideclaw-server` kept showing `exit timeout = 5` after this key
       was raised to 1860, until `make install-agent` (`launchctl bootstrap`) actually loaded
       it — and `launchctl bootstrap` silently no-ops against an already-loaded label unless
       `install-agent` boots the current label out first (measured live on this machine
       2026-09-08: this file already said 2400 while `launchctl print` still reported `exit
       timeout = 5`). `make reload` now refuses to proceed both when the tracked file and the
       installed copy diverge AND when this key disagrees with launchd's own live value — see
       the Makefile and docs/deployment.md § Drain window sizing. -->
  <key>ExitTimeOut</key>
  <integer>2700</integer>

  <!-- ~/Library/Logs, not /tmp. macOS's periodic cleanup sweeps /tmp files
       untouched for 3+ days, and a KeepAlive agent opens its stdio ONCE at
       spawn — so after a sweep the process keeps writing into an UNLINKED
       inode. Measured on this machine 2026-07-31: `lsof -p 895` showed
       /private/tmp/sideclaw.log and .err held open while `ls /tmp/sideclaw.log`
       returned No such file. Every line since the sweep was unrecoverable, and
       sideclaw had no post-mortem at all. Same pattern devhost-health and
       linewatch-collector already use. -->
  <key>StandardOutPath</key>
  <string>/Users/jkrumm/Library/Logs/sideclaw.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jkrumm/Library/Logs/sideclaw.err</string>
</dict>
</plist>
