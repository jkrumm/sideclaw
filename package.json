{
  "name": "sideclaw",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "sideclaw": "bin/sideclaw.ts"
  },
  "scripts": {
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src server tests",
    "format": "oxfmt src server tests --write",
    "format:check": "oxfmt src server tests --check",
    "start": "bun server/index.ts",
    "logs:tail": "tail -f ~/Library/Logs/sideclaw.jsonl | bunx pino-pretty"
  },
  "dependencies": {
    "@blueprintjs/core": "6.20.0",
    "@blueprintjs/icons": "6.14.1",
    "@blueprintjs/select": "6.3.6",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "1.4.10",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "elysia": "1.4.30",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.17.2",
    "normalize.css": "8.0.1",
    "pino": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.4",
    "react-shiki": "0.11.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint-plugin-zod": "4.14.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.58.0",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
