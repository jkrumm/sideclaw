PERSONAL_REPOS_PATH=/Users/yourname/SourceRoot
WORK_REPOS_PATH=/Users/yourname/IuRoot
# Fallback GitHub credential for the issue/branch/PR artifacts `dispatch` creates. The
# primary is `secrets-run read op://mini/github/token`; this is only the documented
# fallback. Reuse local gh CLI session: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
# Per-tool model/backend routing is server/lib/routing.ts (see GET /api/routing).
# Override one tool: SIDECLAW_MODEL_<TOOL>=<model id>, SIDECLAW_BACKEND_<TOOL>=iu|max
# (TOOL = CHECK|OVERVIEW|REVIEW_ROUTER|NARRATIVE|REVIEW|ADVERSARY|DISPATCH|OTEL|
# EXCALIDRAW|READ_IMAGE|READ_DRAWING). A gateway id can never be routed to max, and a
# backend override on adversary/read_image/read_drawing (fixed iu-openai transport, no
# runSession) is refused. SIDECLAW_WORKER_FALLBACK=none pins every tool to its primary
# backend (no reactive quota fallback, no IU-down fallback). Read at module load —
# requires `make reload` to take effect. Applied/refused overrides are logged once at
# startup (routing.overrides).
#SIDECLAW_MODEL_CHECK=
#SIDECLAW_BACKEND_REVIEW=
# Running-job cap (excess submissions queue as pending) and the agent snapshot's
# stale-agent threshold in hours.
#SIDECLAW_JOB_CONCURRENCY=3
#SIDECLAW_AGENT_STALE_HOURS=24
# Lets review angle workers validate an external library/API/version claim via a
# bounded curl to the research-gateway. Unset → the block is empty, review is unchanged.
#RESEARCH_GATEWAY_URL=
#RESEARCH_GATEWAY_TOKEN=
# Argo push target for the agent overview (default https://argo.jkrumm.com/api); the
# bearer is resolved at runtime via `secrets-run read op://common/api/SECRET`.
#ARGO_URL=
