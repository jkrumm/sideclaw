PERSONAL_REPOS_PATH=/Users/yourname/SourceRoot
WORK_REPOS_PATH=/Users/yourname/IuRoot
# GitHub token for PR status, CI checks, and workflow runs
# Reuse local gh CLI session: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
# Set to "true" to enable the GitPanel: git status polling, GitHub API calls,
# chain/git actions. Disabled by default. Frontend reads the VITE_ var.
SIDECLAW_GIT_ENABLED=
VITE_SIDECLAW_GIT_ENABLED=
# Per-tool model/backend routing is server/lib/routing.ts (see GET /api/routing).
# Override one tool: SIDECLAW_MODEL_<TOOL>=<model id>, SIDECLAW_BACKEND_<TOOL>=iu|max
# (TOOL = CHECK|OVERVIEW|NARRATIVE|REVIEW|ADVERSARY|DISPATCH|OTEL|EXCALIDRAW). A gateway
# id can never be routed to max. SIDECLAW_WORKER_FALLBACK=none pins every tool to its
# primary backend (no quota fallback, no IU-down fallback). Read at module load —
# requires `make reload` to take effect.
#SIDECLAW_MODEL_CHECK=
#SIDECLAW_BACKEND_REVIEW=
# Argo push target for the agent overview (default https://argo.jkrumm.com/api); the
# bearer is resolved at runtime via `secrets-run read op://vps/argo/API_SECRET`.
#ARGO_URL=
